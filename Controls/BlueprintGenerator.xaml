<UserControl x:Class="SpaceEditor.Controls.BlueprintGenerator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SpaceEditor.Controls"
             xmlns:colorPicker="clr-namespace:ColorPicker;assembly=ColorPicker"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" MinWidth="400" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Vertical">
            <TextBlock
                Margin="5, 5, 5, 15"
                TextWrapping="Wrap"
                >
                <Run Text="{DynamicResource BlueprintGenerator_BlueprintGeneratorallowsyoutoquickly}" />
                <LineBreak />
                <Run Text="{DynamicResource BlueprintGenerator_Startbyselectingmodel}" />
                <LineBreak />
            </TextBlock>

            <Button 
                Margin="5"
                Click="SelectModel"
                Content="{DynamicResource BlueprintGenerator_SelectModel}"
                />

            <StackPanel
                Orientation="Vertical"
                Name="GenerateBlueprintPanel"
                Visibility="Hidden"
                Margin="5"
                >

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <local:ReflectedObject x:Name="GeneratorSettings" />
                    <local:ReflectedObject x:Name="ModelSettings" Grid.Column="1" />
                </Grid>

                <Button
                    Click="GenerateBlueprint"
                    Content="{DynamicResource BlueprintGenerator_ThePreviewlooksgoodConvertit}"
                />
            </StackPanel>

            <StackPanel
                Visibility="Collapsed"
                Orientation="Vertical"
                Name="ExportBlueprintPanel"
                >
                <TextBox
                    Margin="5"
                    Name="BlueprintName"
                    />

                <Button
                    Margin="5"
                    Click="ExportBlueprint"
                    Content="{DynamicResource BlueprintGenerator_TheBlueprintlooksgoodExportit}"
                    />

                <Button
                    Margin="5"
                    Click="ExportBlueprintAsModel"
                    Content="{DynamicResource BlueprintGenerator_Iwouldliketoexaminethe}"
                />
            </StackPanel>
        </StackPanel>

        <TextBlock
            Margin="5"
            Grid.Row="0"
            Grid.Column="0"
            FontStyle="Italic"
            TextWrapping="Wrap"
            VerticalAlignment="Bottom"
            >
            <Run Text="{DynamicResource BlueprintGenerator_Blueprintgeneratorisexperimentalfeature}" />
            <LineBreak />
            <Run Text="{DynamicResource BlueprintGenerator_Furtherimprovementswillbedonebased}" />
        </TextBlock>

        <Grid
            Grid.Column="1"
            >
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Image
                VerticalAlignment="Bottom"
                HorizontalAlignment="Right"
                Opacity="0.4"
                Stretch="Fill"
                Margin="2, 0, 0, 0"
                Source="pack://application:,,,/Resources/SpaceEditor.png"
                />

            <local:ModelViewport
                x:Name="ModelsViewport"
                />

            <StackPanel
                IsHitTestVisible="False"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Right"
                >
                <StackPanel.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="FontSize" Value="15" />
                        <Setter Property="FontWeight" Value="Bold" />
                        
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Resources>

                <TextBlock x:Name="ModelDetails" />
                <TextBlock x:Name="BlueprintDetails" />
            </StackPanel>

            <Grid
                Grid.Row="1"
                Name="ViewportControls"
                >
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.Resources>
                    <ResourceDictionary>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="0, 0, 10, 0"></Setter>
                        </Style>
                        <Style TargetType="{x:Type CheckBox}">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="0, 0, 10, 0"></Setter>
                        </Style>
                    </ResourceDictionary>
                </Grid.Resources>
                
                <TextBlock FontWeight="Bold" Text="{DynamicResource BlueprintGenerator_Model}" />
                <TextBlock FontWeight="Bold" Text="{DynamicResource BlueprintGenerator_Blueprint}" Grid.Row="1" />

                <CheckBox
                    Grid.Row="0"
                    Grid.Column="1"
                    Content="{DynamicResource BlueprintGenerator_Draw}"
                    IsChecked="True"
                    VerticalAlignment="Center"
                    />
                
                <CheckBox
                    Grid.Row="1"
                    Grid.Column="1"
                    Content="{DynamicResource BlueprintGenerator_Draw}"
                    IsChecked="True"
                    />

                <CheckBox
                    Grid.Row="0"
                    Grid.Column="2"
                    Content="{DynamicResource BlueprintGenerator_XRay}"
                    Name="XRayModel"
                    />

                <CheckBox
                    Grid.Row="1"
                    Grid.Column="2"
                    Content="{DynamicResource BlueprintGenerator_XRay}"
                    Name="XRayBlueprint"
                    />

                <local:ColourSlider
                    Grid.Row="0"
                    Grid.Column="3"
                    SelectedColour="Gray"
                    />

                <local:ColourSlider
                    Grid.Row="1"
                    Grid.Column="3"
                    SelectedColour="Red"
                    x:Name="BlueprintColor"
                    />
            </Grid>
            
            </Grid>
    </Grid>
</UserControl>
