<Application x:Class="SpaceEditor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SpaceEditor"
             xmlns:services="clr-namespace:SpaceEditor.Services"
             xmlns:controls="clr-namespace:SpaceEditor.Controls"
             StartupUri="MainWindow.xaml"
             Exit="OnExit">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Controls/ColourSlider.xaml" />
                <ResourceDictionary Source="Localization/Strings.en.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <controls:LocalizedNameConverter x:Key="LocalizedNameConverter" />
            <DataTemplate x:Key="LocalizedTypeNameTemplate">
                <TextBlock>
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource LocalizedNameConverter}">
                            <Binding Path="Key" />
                            <Binding Path="LanguageCode" Source="{x:Static services:LocalizationManager.Current}" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </DataTemplate>
            <DataTemplate x:Key="LocalizedPresetNameTemplate">
                <TextBlock>
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource LocalizedNameConverter}" ConverterParameter="Preset">
                            <Binding Path="Key" />
                            <Binding Path="LanguageCode" Source="{x:Static services:LocalizationManager.Current}" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </DataTemplate>
            <DataTemplate x:Key="LocalizedActionNameTemplate">
                <TextBlock>
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource LocalizedNameConverter}">
                            <Binding Path="DisplayName" />
                            <Binding Path="LanguageCode" Source="{x:Static services:LocalizationManager.Current}" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </DataTemplate>

            <Style TargetType="GridSplitter">
                <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
                <Setter Property="Background" Value="#FF7F7F7F"/>
                <Setter Property="Width" Value="4"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
