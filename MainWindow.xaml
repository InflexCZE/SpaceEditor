<Window x:Class="SpaceEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SpaceEditor"
        xmlns:pt="http://propertytools.org/wpf"
        xmlns:controls="clr-namespace:SpaceEditor.Controls"
        xmlns:services="clr-namespace:SpaceEditor.Services"
        mc:Ignorable="d"
        Title="Space Editor"
        Height="550"
        Width="1000"
        d:DataContext="{local:MainWindow}"
        >
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
            <TextBlock Text="{DynamicResource LanguageLabel}" VerticalAlignment="Center" Margin="0,0,5,0" />
            <ComboBox ItemsSource="{x:Static services:LocalizationManager.Languages}"
                      DisplayMemberPath="DisplayName"
                      SelectedValuePath="Code"
                      SelectedValue="{Binding LanguageCode, Source={x:Static services:LocalizationManager.Current}, Mode=TwoWay}" />
        </StackPanel>
    <TabControl
        Name="MainTabs"
        >
        <TabItem Header="{DynamicResource MainWindow_Main}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Orientation="Horizontal"
                    Margin="0, 0, 0, 2"
                    >
                    <TextBox Text="{Binding GamePath}" Width="400"  />
                    <Button Margin="2, 0, 0, 0" Padding="4, 2, 4, 2" Click="OnLocateGame" Content="{DynamicResource MainWindow_LocateGame}" />
                </StackPanel>

                <Grid
                    Grid.Row="1"
                    Grid.Column="0"
                    >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    
                    <TextBox
                        Name="InfoText"
                        IsReadOnly="True"
                        />

                    <StackPanel
                        Margin="5"
                        Grid.Row="2"
                        Grid.Column="0"
                        Name="UpdateHints"
                        Visibility="Collapsed"
                        Orientation="Horizontal"
                    >

                        <TextBlock
                            FontSize="30"
                            FontFamily="Segoe MDL2 Assets"
                            Foreground="OrangeRed"
                            Text="&#xE7BA;"
                        />

                        <TextBlock
                            VerticalAlignment="Center"
                            Text=" "
                        >
                            <Run Text="{DynamicResource MainWindow_Newversionavailable}" />
                            <Hyperlink NavigateUri="https://github.com/InflexCZE/SpaceEditor/releases/latest" RequestNavigate="CheckOutUpdate">
                                <Run Text="{DynamicResource MainWindow_Seewhatsnew}" />
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <Image
                    Grid.Row="1"
                    Grid.Column="1"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Right"
                    Opacity="0.4"
                    Stretch="Fill"
                    Source="pack://application:,,,/Resources/SpaceEditor.png"
                    />

                <Grid
                    Grid.Row="1"
                    Grid.Column="1"
                    >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="FontSize" Value="15" />
                        </Style>
                    </Grid.Resources>

                    <TextBlock
                        Text="{DynamicResource MainWindow_Changelog}"
                        FontSize="35"
                        FontWeight="Bold"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="5"
                        />

                    <ScrollViewer
                        Grid.Row="1"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Auto"
                        >
                        <TextBlock
                            Margin="10, 0, 0, 0"
                            >
                            <Run FontSize="20" FontWeight="Bold" Text="{DynamicResource MainWindow_Dec32025v111}" />
                            <LineBreak />
                            <Run Text="{DynamicResource MainWindow_FixedPCUunlockertoaccountalso}" />
                            <LineBreak />
                            <LineBreak />

                            <Run FontSize="20" FontWeight="Bold" Text="{DynamicResource MainWindow_Nov302025v110}" />
                            <LineBreak />
                            <Run Text="{DynamicResource MainWindow_ReadyforVS2}" />
                            <LineBreak />
                            <LineBreak />

                            <Run FontSize="20" FontWeight="Bold" Text="{DynamicResource MainWindow_Aug102025v103}" />
                            <LineBreak />
                            <Run Text="{DynamicResource MainWindow_AddedModelscalingtoBlueprintGenerator}" />
                            <LineBreak />
                            <Run Text="{DynamicResource MainWindow_Addedautocheckforlatestversion}" />
                            <LineBreak />
                            <LineBreak />

                            <Run FontSize="20" FontWeight="Bold" Text="{DynamicResource MainWindow_Jul292025v102}" />
                            <LineBreak />
                            <Run Text="{DynamicResource MainWindow_FixedGamecrashwhenimporting0}" />
                            <LineBreak />
                            <LineBreak />

                            <Run FontSize="20" FontWeight="Bold" Text="{DynamicResource MainWindow_Jul282025v101}" />
                            <LineBreak />
                            <Run Text="{DynamicResource MainWindow_Added05mBlockstoBlueprint}" />
                            <LineBreak />
                            <Run Text="{DynamicResource MainWindow_Fixedsometimesbuggyrenderof3D}" />
                            <LineBreak />
                            <LineBreak />

                            <Run FontSize="20" FontWeight="Bold" Text="{DynamicResource MainWindow_Jul262025v100}" />
                            <LineBreak />
                            <Run Text="{DynamicResource MainWindow_AddedBlueprintGenerator}" />
                            <LineBreak />
                            <LineBreak />

                            <Run FontSize="20" FontWeight="Bold" Text="{DynamicResource MainWindow_Jun72025v093}" />
                            <LineBreak />
                            <Run Text="{DynamicResource MainWindow_AddedCharacterEditor}" />
                            <LineBreak />
                            <Run Text="{DynamicResource MainWindow_CanchangeCharactersuitcolor}" />
                            <LineBreak />
                            <LineBreak />

                            <Run FontSize="20" FontWeight="Bold" Text="{DynamicResource MainWindow_May132025v092}" />
                            <LineBreak />
                            <Run Text="{DynamicResource MainWindow_AddedPCUUnlocker}" />
                            <LineBreak />
                            <LineBreak />

                            <Run FontSize="20" FontWeight="Bold" Text="{DynamicResource MainWindow_May122025v091}" />
                            <LineBreak />
                            <Run Text="{DynamicResource MainWindow_Fixeddetectionofbinslocationin}" />
                            <LineBreak />
                            <LineBreak />
                            
                            <Run FontSize="20" FontWeight="Bold" Text="{DynamicResource MainWindow_May122025v09}" />
                            <LineBreak />
                            <Run Text="{DynamicResource MainWindow_LocatesandloadsSE2binaries}" />
                            <LineBreak />
                            <Run Text="{DynamicResource MainWindow_KeyBindsEditorMk1}" />
                            <LineBreak />
                            <Run Text="{DynamicResource MainWindow_WritesnewBindingstoSE2Content}" />
                        </TextBlock>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </TabItem>
    </TabControl>
    </DockPanel>

</Window>
